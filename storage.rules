rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ─── Avatars ────────────────────────────────────────────────────────
    // Uploads use the path "avatars/<uid>-<timestamp>.<ext>", so the file
    // name always starts with the owner's Firebase UID. Only the owner may
    // write; any signed-in user may read (avatars are shown across the app).
    match /avatars/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && file.split('-')[0] == request.auth.uid;
    }

    // ─── Everything else: deny by default (defense in depth) ───────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
