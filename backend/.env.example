# AgentOS Studio — Environment Variables
# Copy to .env and fill in your values

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME?ssl=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Security ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ENCRYPTION_KEY=change-me-to-another-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Redis / Queue ────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# ─── OpenTelemetry ────────────────────────────────────
OTEL_SERVICE_NAME=agentos-studio
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Storage ──────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_PATH=./data/artifacts

# ─── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=true
