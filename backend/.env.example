[TEMPLATE]
# AgentOS Studio - Environment Variables (Firebase-first)
# Copy to .env and fill in your values.

# --- Firebase / Google Cloud (required - the data store) ---
# FIREBASE_PRIVATE_KEY + FIREBASE_CLIENT_EMAIL (service account) is the
# production-grade path. Alternatively, FIREBASE_REFRESH_TOKEN +
# FIREBASE_CLIENT_ID (from firebase login) works too.
FIREBASE_PROJECT_ID=agentos-7f01e
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_REFRESH_TOKEN=
FIREBASE_CLIENT_ID=
FIREBASE_USER_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Security ---
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ENCRYPTION_KEY=change-me-to-another-random-key-in-production

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# --- Storage ---
ARTIFACT_STORAGE_PATH=./data/artifacts
WORKSPACE_STORAGE_PATH=./data/workspaces

# --- First superuser ---
FIRST_SUPERUSER_EMAIL=you@example.com

# --- Misc ---
PROJECT_NAME=AgentOS Studio
VERSION=0.1.0
DEBUG=true
