# AgentOS Studio - Environment Variables (Firebase-first)
# Copy to .env and fill in your values.

# --- Firebase / Google Cloud (required - the data store) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_REFRESH_TOKEN=
FIREBASE_CLIENT_ID=
FIREBASE_USER_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Security ---
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ENCRYPTION_KEY=change-me-to-another-random-key-in-production

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# --- Storage ---
ARTIFACT_STORAGE_PATH=./data/artifacts
WORKSPACE_STORAGE_PATH=./data/workspaces

# --- First superuser ---
FIRST_SUPERUSER_EMAIL=you@example.com

# --- AgentRouter (DeepSeek V4 proxy) ---
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://deepseek-console-913582f071dc.herokuapp.com/v1

# --- LLM Provider API Keys (auto-seed on startup when set) ---
# Leave empty to disable. Set the key and the provider auto-registers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
